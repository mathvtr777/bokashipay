# --- Supabase ---
# A publishable key é pública por design e pode ir para o frontend.
NEXT_PUBLIC_SUPABASE_URL=https://anapagpjwljzpbwjerng.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__4fgthaqcmLS_IkBqyZv-A_DobsivqA

# A SECRET key NUNCA deve ser exposta ao frontend. Usada apenas no servidor.
# Necessária para: webhooks da Pushin Pay, gravação de segredos de integração.
# Supabase Dashboard > Project Settings > API Keys
SUPABASE_SECRET_KEY=

# --- Adquirente: Pushin Pay ---
# Geração e consulta de cobranças PIX.
# Sem o token, a tela de PIX mostra "Integração não configurada" e nenhuma
# cobrança é emitida — nenhum QR Code é gerado localmente.
# Token em: app.pushinpay.com.br > Configurações > API
PUSHINPAY_API_URL=https://api.pushinpay.com.br/api
PUSHINPAY_API_TOKEN=

# Sandbox (pedir liberação ao suporte da Pushin Pay antes de usar):
# PUSHINPAY_API_URL=https://api-sandbox.pushinpay.com.br/api

# Verificação do webhook. A Pushin Pay envia um header customizado de VALOR
# ESTÁTICO (não é assinatura HMAC), escolhido no menu de configurações dela.
# Defina aqui o mesmo valor e, se quiser trocar o nome do header, o nome também.
# Sem isto, o webhook aceita chamadas sem verificação — e avisa no log.
PUSHINPAY_WEBHOOK_SECRET=
PUSHINPAY_WEBHOOK_HEADER=x-bokashipay-secret

# URL pública do BokashiPay. Necessária para o provedor conseguir chamar o
# webhook de produção (a URL é montada a partir do host da requisição, mas
# explicitar é mais seguro em ambientes com proxy).
PUSHINPAY_PUBLIC_URL=

# --- Administrador ---
# E-mails com acesso ao painel /admin/saques. Separado por vírgula.
# A checagem acontece no servidor; adicionar alguém aqui exige reiniciar.
ADMIN_USER_EMAILS=


# --- UTMFY ---
# Base URL e endpoints ficam configuráveis por variável, nunca hardcoded no código.
UTMFY_API_URL=
UTMFY_API_KEY=
UTMFY_WEBHOOK_SECRET=